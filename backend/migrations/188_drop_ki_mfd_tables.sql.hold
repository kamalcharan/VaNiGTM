-- ============================================================================
-- Migration 188: Phase 0 Stage 0.5 — drop KI-Prime (MFD) legacy tables
--
-- ⛔ DO NOT APPLY until ALL of the following are true:
--   1. Migration 187 applied (gt_contacts live, assignments FK re-pointed).
--   2. Stage 0.3 code re-point deployed (contact-skill reads/writes gt_*).
--   3. Stage 0.4 deployed (client/etl/pulse MFD skills + MFD pages removed;
--      `grep -r "ki_" backend/src` shows no references to dropped tables).
--   4. Fresh DB backup taken:  pg_dump -Fc vani_gtm_db > pre_188.dump
--
-- The row-count report below runs first — review its NOTICE output before
-- the drops execute (run the DO block alone if you want a dry look).
--
-- Apply manually: cd backend && npm run db:migrate
-- ============================================================================

-- ────────────────────────────────────────────────────────────────────────────
-- 0. Row-count report (informational — review before proceeding)
-- ────────────────────────────────────────────────────────────────────────────

DO $$
DECLARE
    t TEXT;
    n BIGINT;
BEGIN
    FOR t IN
        SELECT table_name FROM information_schema.tables
        WHERE table_schema = 'public' AND table_name LIKE 'ki\_%' ESCAPE '\'
        ORDER BY table_name
    LOOP
        EXECUTE format('SELECT COUNT(*) FROM %I', t) INTO n;
        RAISE NOTICE '[188] % : % rows', t, n;
    END LOOP;
END $$;

BEGIN;

-- ────────────────────────────────────────────────────────────────────────────
-- 1. Contact layer (superseded by gt_contacts / gt_contact_channels in 187)
--    Children first; CASCADE clears dependent views/constraints if any.
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_contact_snapshot        CASCADE;  -- 1:1 skimmed financials
DROP TABLE IF EXISTS ki_contact_snapshots       CASCADE;  -- older plural variant
DROP TABLE IF EXISTS ki_snapshot_assets         CASCADE;
DROP TABLE IF EXISTS ki_snapshot_expenses       CASCADE;
DROP TABLE IF EXISTS ki_snapshot_goals          CASCADE;
DROP TABLE IF EXISTS ki_snapshot_income         CASCADE;
DROP TABLE IF EXISTS ki_snapshot_liabilities    CASCADE;
DROP TABLE IF EXISTS ki_snapshot_protection     CASCADE;
DROP TABLE IF EXISTS ki_intake_tokens           CASCADE;  -- MFD intake-form flow
DROP TABLE IF EXISTS ki_contact_channels        CASCADE;
DROP TABLE IF EXISTS ki_contacts                CASCADE;

-- ────────────────────────────────────────────────────────────────────────────
-- 2. Client / portfolio / planning domain (MFD product)
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_customer_asset_assignments CASCADE;
DROP TABLE IF EXISTS ki_client_bookmarks        CASCADE;
DROP TABLE IF EXISTS ki_bookmark_reasons        CASCADE;
DROP TABLE IF EXISTS ki_client_addresses        CASCADE;
DROP TABLE IF EXISTS ki_goal_projections        CASCADE;
DROP TABLE IF EXISTS ki_goals                   CASCADE;
DROP TABLE IF EXISTS ki_holdings                CASCADE;
DROP TABLE IF EXISTS ki_transactions            CASCADE;
DROP TABLE IF EXISTS ki_transaction_types       CASCADE;
DROP TABLE IF EXISTS ki_portfolios              CASCADE;
DROP TABLE IF EXISTS ki_families                CASCADE;
DROP TABLE IF EXISTS ki_clients                 CASCADE;
DROP TABLE IF EXISTS ki_asset_types             CASCADE;
DROP TABLE IF EXISTS ki_liability_types         CASCADE;

-- ────────────────────────────────────────────────────────────────────────────
-- 3. Market data / schemes / NAV (MFD reference data)
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_scheme_bookmarks        CASCADE;
DROP TABLE IF EXISTS ki_scheme_aliases          CASCADE;
DROP TABLE IF EXISTS ki_scheme_categories       CASCADE;
DROP TABLE IF EXISTS ki_nav_history             CASCADE;
DROP TABLE IF EXISTS ki_schemes                 CASCADE;
DROP TABLE IF EXISTS ki_market_data             CASCADE;
DROP TABLE IF EXISTS ki_market_indices          CASCADE;
DROP TABLE IF EXISTS ki_market_jobs             CASCADE;

-- ────────────────────────────────────────────────────────────────────────────
-- 4. Import / ETL / correction pipeline (MFD data ops)
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_correction_steps        CASCADE;
DROP TABLE IF EXISTS ki_corrections             CASCADE;
DROP TABLE IF EXISTS ki_import_staging          CASCADE;
DROP TABLE IF EXISTS ki_import_sessions         CASCADE;
DROP TABLE IF EXISTS ki_file_uploads            CASCADE;
DROP TABLE IF EXISTS ki_job_scheduler_configs   CASCADE;
DROP TABLE IF EXISTS ki_job_types               CASCADE;
DROP TABLE IF EXISTS ki_scheduler_configs       CASCADE;
DROP TABLE IF EXISTS ki_scheduler_executions    CASCADE;

-- ────────────────────────────────────────────────────────────────────────────
-- 5. Pulse (MFD JTBD nudges) + alerts + misc
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_pulse_session_actions      CASCADE;
DROP TABLE IF EXISTS ki_pulse_session_gaps         CASCADE;
DROP TABLE IF EXISTS ki_pulse_session_observations CASCADE;
DROP TABLE IF EXISTS ki_pulse_sessions             CASCADE;
DROP TABLE IF EXISTS ki_pulse_config               CASCADE;
DROP TABLE IF EXISTS ki_alerts                     CASCADE;
DROP TABLE IF EXISTS ki_sequences                  CASCADE;  -- counter table; replaced by gt_seq_counters (mig 189)
DROP FUNCTION IF EXISTS ki_next_seq(UUID, TEXT);              -- replaced by gt_next_seq (mig 189)

-- ────────────────────────────────────────────────────────────────────────────
-- 6. Lookup/code tables — VERIFY before this section runs:
--    vn_tenants.customer_id_type_code / ext_ref_type_code are soft codes that
--    may reference these lookups. Confirm nothing in backend/src reads them
--    (grep ki_customer_id_types / ki_ext_ref_types) before applying.
--    If in doubt, comment these two out and drop later.
-- ────────────────────────────────────────────────────────────────────────────

DROP TABLE IF EXISTS ki_customer_id_types       CASCADE;
DROP TABLE IF EXISTS ki_ext_ref_types           CASCADE;

COMMIT;

-- ────────────────────────────────────────────────────────────────────────────
-- 7. Post-apply verification
-- ────────────────────────────────────────────────────────────────────────────
-- SELECT table_name FROM information_schema.tables
--  WHERE table_schema = 'public' AND table_name LIKE 'ki\_%' ESCAPE '\';
-- Expect: 0 rows.
--
-- Also confirm app + worker start clean and /campaigns contact flows work
-- (they should be on gt_contacts via migration 187 + Stage 0.3 code).
