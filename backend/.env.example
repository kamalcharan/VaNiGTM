# ═══════════════════════════════════════════════════════
# KI-Prime Backend — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────
# PostgreSQL connection string (VPS-hosted, shared VN_ + KI_ tables)
DB_PRIMARY=postgresql://user:password@host:5432/ki_prime_db

# SSL for remote connections (Railway/DO → VPS). Set false for local dev.
DB_PRIMARY_SSL=false

# Runtime role vs owner role. DB_PRIMARY is what the API and worker run as —
# in production that is meant to be vanigtm_app (NOSUPERUSER NOBYPASSRLS, so
# RLS applies). DB_MIGRATE is the OWNER's connection (vikuna_admin), used ONLY
# by the migration runner, because migrations are DDL and the app role has
# none. Leave DB_MIGRATE unset while DB_PRIMARY is still the owner.
# DB_MIGRATE=postgresql://vikuna_admin:password@host:5432/vani_gtm_db

# ── Auth ────────────────────────────────────────────────
# JWT signing secret (min 32 chars in production)
JWT_SECRET=change-me-in-production

# Max concurrent sessions per user (overrides VN_subscriptions.max_sessions)
MAX_SESSIONS=50

# ── Server ──────────────────────────────────────────────
# Express port
PORT=3001

# CORS origins — COMMA-SEPARATED. One API serves more than one console.
#
# Every browser origin that may call this API. Matched EXACTLY, per entry: no
# wildcards, no prefixes. credentials:true means these origins can hold a
# session cookie, so each one is a deliberate decision.
#
# Leave an origin out and its console gets every preflight refused. That is
# invisible here — the browser blocks it, the server logs nothing, and curl
# cannot reproduce it because curl sends no Origin header. In vani-app it reads
# as "Cannot reach the VaNi service", which looks exactly like the API being
# down. The allowed list is printed at startup so you can check it.
#
# No trailing slashes: a browser sends `Origin: http://localhost:3000` with no
# path, so an entry with a slash matches nothing (they are stripped anyway).
#
#   :3100  — vani-app, the console (`npm run dev:ui`).
CORS_ORIGIN=http://localhost:3100

# Environment: 'development' for console logging, 'production' for vn_error_log
NODE_ENV=development

# ── Feature Flags ───────────────────────────────────────
# Skip real AI/LLM calls (use mock responses)
VANI_MOCK=true

# ── Vikuna Agent Core — the LLM (ALL REQUIRED, no defaults in code) ──
# Charan, 2026-09-30: qwen on Vikuna's own VPS is the platform model, Haiku is
# the fallback, and every setting comes from here — nothing in code stands in
# for a missing one. The API and the worker REFUSE TO START if any line below
# is missing or malformed, and print every problem at once
# (agent-core/llm.config.ts). An empty value is allowed only where noted.
#
# PLATFORM model: any OpenAI-compatible /v1/chat/completions endpoint (llama.cpp
# server, vLLM, Ollama's /v1). What Vikuna pays for; BYOK tenants never use it.
LLM_PRIMARY_URL=https://your-qwen-host/v1
LLM_PRIMARY_MODEL=qwen3-8b
# Empty = the endpoint has no auth (allowed, but must be written).
LLM_PRIMARY_KEY=
# The FLOOR for a call's timeout; the ceiling is derived per call from the
# prompt size and the model's measured speed.
LLM_PRIMARY_TIMEOUT_MS=60000
# Appended to every PLATFORM system prompt. /no_think stops qwen3 writing a
# reasoning block. Empty = none (e.g. if the platform model is not a qwen).
LLM_PRIMARY_SYSTEM_SUFFIX=/no_think
# The window the server REALLY serves (its n_ctx) — a server fact, not a
# preference. Every prompt builder derives its cap from it. 0 = unknown.
# Vikuna's self-hosted qwen: 16k (Charan, 2026-09-30). llama.cpp-style servers
# split n_ctx across --parallel slots, so this holds only while the server
# runs ONE slot — keep it in step with LLM_MAX_CONCURRENT=1.
LLM_CONTEXT_TOKENS=16384
# Platform calls in flight at once ACROSS EVERY PROCESS (API + workers), via
# Postgres advisory locks (C5). 1 for a single small model server.
LLM_MAX_CONCURRENT=1
# A tenant's own endpoint (BYOK): calls in flight at once, per process.
LLM_BYOK_MAX_CONCURRENT=4
# Cold-start guesses, replaced by measurement after the first calls:
# characters per token (qwen on crawl text ≈ 3) and generation speed.
LLM_CHARS_PER_TOKEN=3
LLM_TOKENS_PER_SEC=10

# ── Fallback: Claude (user-approved rule-12 exception) ──
# When the platform model fails at the transport level, the SAME call can be
# retried once on Claude. Never silent: a visible 'llm_failover' run step, and
# tokens under the 'escalation' bucket. Empty key = no fallback at all.
ANTHROPIC_API_KEY=
# Required whenever ANTHROPIC_API_KEY is set.
LLM_FAILOVER_MODEL=claude-haiku-4-5
# true  = fail over on its own (Vikuna is billed without asking)
# false = park the run and ask a person first (llm-provider-skill.pending_failovers)
HAIKU_DEFAULT=false

# ── LLM budget and timeout arithmetic (all REQUIRED) ────
# Moved out of code on Charan's ruling (2026-09-30). Change with care: they
# decide how big a prompt may be built and how long a call is waited for.
# Tokens inside the window taken by the chat template and role markers.
LLM_TEMPLATE_OVERHEAD_TOKENS=200
# Tokens kept back for a caller's own wrapper around budgeted text.
LLM_BUDGET_SLACK_TOKENS=64
# Safety factor (0–1] applied to the ratio learned from a "too large" refusal.
LLM_OVERFLOW_MARGIN=0.9
# Calls before a learned chars/token ratio is trusted over LLM_CHARS_PER_TOKEN.
LLM_CALIBRATION_MIN_SAMPLES=3
# Answers shorter than this measure latency, not speed, and are ignored.
LLM_SPEED_MIN_SAMPLE_TOKENS=50
# A measured speed may not exceed this multiple of LLM_TOKENS_PER_SEC.
LLM_SPEED_MAX_MULTIPLE=4
# How much faster the server reads a prompt than it writes an answer.
LLM_PREFILL_FACTOR=10
# Added to every derived timeout for connection and queueing.
LLM_TIMEOUT_SLACK_MS=15000
# Used only when a caller names none.
LLM_DEFAULT_MAX_TOKENS=1000
LLM_DEFAULT_TEMPERATURE=0.2
# Extraction answer reserve = window ÷ divisor, clamped to [min, max].
LLM_EXTRACT_ANSWER_DIVISOR=8
LLM_EXTRACT_ANSWER_MIN=800
LLM_EXTRACT_ANSWER_MAX=3000

# ── Worker (all REQUIRED, checked when the worker starts) ──
WORKER_POLL_MS=3000
WORKER_BATCH_SIZE=5
WORKER_HEARTBEAT_MS=30000
# A claim with no heartbeat for this many seconds is presumed orphaned.
WORKER_STALE_CLAIM_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# ── Import pipeline (ALL REQUIRED, no defaults in code — src/etl/etl.config.ts) ──
# The API and the worker refuse to start without them.
# Largest upload accepted. nginx's `location /api/v1/etl/upload` must allow at
# least this much (deploy/vani-main-vps/api.vikuna.io.conf), or nginx answers
# 413 before the API sees the file.
ETL_UPLOAD_MAX_BYTES=10485760
# Files above this are staged by the worker in chunks (IMPORT_STAGE_REQUESTED);
# smaller ones in the request, as before. Only CSV can be staged in chunks — a
# workbook above it is refused with "save it as CSV".
# UNTIL P1 sprint B: keep this equal to ETL_UPLOAD_MAX_BYTES, so every file
# stages in the request as before — the console does not yet show a 'staging'
# (202) answer. Sprint B wires that screen; then lower this (e.g. 5242880) and
# raise the upload limit (e.g. 209715200, nginx already allows 200m).
ETL_SYNC_MAX_BYTES=10485760
# Rows per worker chunk; one transaction each, and the resume point after a crash.
ETL_STAGE_CHUNK_ROWS=1000
# Where an upload waits until its rows are staged. TEMPORARY (Charan,
# 2026-10-02): the file is deleted once staged; only its metadata is kept.
# On the VPS the API and the worker must mount the SAME host folder here, or
# the worker cannot read a large CSV it was asked to stage. Locally: ./uploads.
ETL_UPLOAD_DIR=./uploads
# An upload that never reached staging is deleted after this many hours.
ETL_UPLOAD_TEMP_TTL_HOURS=24

# ── Embeddings (free-text intent routing) ───────────────
# Not checked at start — only free-text questions in the widget use it, and
# they answer "unavailable" (EMBED_NOT_CONFIGURED) until these are set.
# Which provider is still decision D6.
# EMBED_URL=http://your-ollama-host:11434
# EMBED_MODEL=nomic-embed-text
# EMBED_KEY=
# EMBED_TIMEOUT_MS=30000
# EMBED_DIM=768                      (must match the vector(768) columns, migration 246)

# ── Tenant secret encryption (BYOK) ────────────────────
# Encrypts secrets a TENANT owns and we merely hold — today the BYOK LLM API
# key in vani_llm_provider.credentials_enc. AES-256-GCM, applied in Node so
# the key never reaches the database.
#
# REQUIRED once any tenant declares their own model provider. Without it,
# saving or using a BYOK key fails loudly with SECRET_KEY_NOT_CONFIGURED —
# there is deliberately no default key, because a shared default is the same
# as no encryption while looking exactly like encryption.
#
# Generate:  openssl rand -base64 32
# Never commit a real value. Losing this key means every stored tenant key is
# unrecoverable and each tenant must re-enter theirs.
TENANT_SECRET_KEY=
#
# Rotation: set this to the OUTGOING key and both generations decrypt during
# the changeover. Re-encrypt the stale rows, then remove this line.
TENANT_SECRET_KEY_PREVIOUS=

# ── Do-not-contact list (D9, comms/may-contact.ts) ──────
# Addresses on the suppression list are stored only as HMAC-SHA256 under this
# key (design-notes-consent.md, D9-b). No default; at least 32 characters.
# NOT checked at startup — nothing sends yet — but without it the contact
# gate refuses every contact (SUPPRESSION_NOT_CONFIGURED).
# Generate:  openssl rand -base64 48
# NEVER rotate casually and back it up with the other secrets: a changed or
# lost key makes every stored block unmatchable, and blocked people could be
# contacted again.
SUPPRESSION_HASH_KEY=

# ── Website preview before signup (Track E1, src/funnel) ─
# All required, no defaults. NOT checked at startup: without them the preview
# routes answer 503 FUNNEL_NOT_CONFIGURED and the rest of the API is unaffected.
# Approved values (Charan, 2026-09-30): reuse 30 days.
# A site read this recently is reused for everyone (720 = 30 days, approved).
FUNNEL_REUSE_HOURS=720
# NEW reads one IP may start per hour (reused cards do not count).
FUNNEL_MAX_PER_IP_PER_HOUR=
# Unclaimed previews are deleted after this many days.
FUNNEL_SESSION_DAYS=
# The vikuna-funnel tenant's daily token cap = the ceiling on anonymous spend.
FUNNEL_DAILY_TOKEN_LIMIT=
# A read still running after this many minutes is treated as dead.
FUNNEL_READ_TIMEOUT_MINUTES=
# >= 32 chars; visitor IPs are stored only as HMAC. Generate: openssl rand -base64 48
FUNNEL_IP_HASH_KEY=
# Most chunks of homepage text the "this is your data" graph may send to the
# model per NEW read (migration 262) — the per-read cost ceiling. Suggested 3.
FUNNEL_GRAPH_MAX_CHUNKS=
# The workspace (vn_tenants.slug) that Request access leads land in —
# connect@vikuna.io's. Checked on its own: missing switches off only the form.
FUNNEL_LEADS_TENANT_SLUG=

# ── Headless render escalation (ingestion-skill) ────────
# n8n webhook that renders JS-only pages via browserless. Optional — when
# unset, thin JS-rendered sites fail loudly with RENDER_NOT_CONFIGURED and
# the wizard offers the paste-copy path. See documents/n8n/README.md.
# N8N_ENV=live routes to /webhook, anything else to /webhook-test.
N8N_RENDER_URL=
N8N_RENDER_SECRET=
N8N_ENV=test

# ── Web search (research-skill) ─────────────────────────
# Self-hosted SearXNG instance for outward competitor research. The JSON
# API must be enabled in its settings.yml. Setup: docs/searxng-setup.md.
# When unset, competitor research fails loudly with SEARCH_NOT_CONFIGURED.
SEARXNG_URL=

# ── Google Drive (ingestion-skill) ──────────────────────
# OAuth credentials for connecting a tenant's Google Drive folder as a
# knowledge source. Create a Web Application client in Google Cloud Console
# and add the redirect URI to the authorized list.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost:3000/api/v1/ingest/connect/gdrive/callback
