{
  "name": "VaNi GTM - Render Page (browserless)",
  "nodes": [
    {
      "parameters": {
        "content": "VaNi GTM — headless page render (STOCK NODES ONLY)\n\nSame contract as the puppeteer variant, but rendering is done\nby a browserless container — no community node needed.\n\nPOST /vani-render-page\nbody: { \"url\": \"https://…\" }\nheader: x-vani-secret  (must equal env VANI_RENDER_SECRET)\nReturns { success, url, chars, html }.\n\nSETUP (once):\n1. Run browserless on the VPS:\n   docker run -d --name browserless --restart unless-stopped \\\n     -p 3010:3000 -e \"TOKEN=<random>\" ghcr.io/browserless/chromium\n2. n8n instance env:\n   VANI_RENDER_SECRET=<long random string>\n   BROWSERLESS_URL=http://<vps-ip-or-container-host>:3010\n   BROWSERLESS_TOKEN=<same as TOKEN above>\n3. Import this workflow and activate.",
        "height": 620,
        "width": 440,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [-2464, -16],
      "typeVersion": 1,
      "id": "b1b2c3d4-0001-4000-8000-000000000001",
      "name": "Sticky Note - Render Page Browserless"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vani-render-page",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Render Page Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [-1980, 200],
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "webhookId": "vani-render-page-002"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.url !== undefined && $json.body.url.startsWith('http') && $json.headers['x-vani-secret'] === $env.VANI_RENDER_SECRET && $env.VANI_RENDER_SECRET !== undefined && $env.VANI_RENDER_SECRET !== '' }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Validate Render Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-1772, 200],
      "id": "b1b2c3d4-0003-4000-8000-000000000003"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "status", "value": "error" },
            { "name": "errorCode", "value": "INVALID_INPUT_OR_AUTH" },
            { "name": "message", "value": "Missing/invalid url, or bad x-vani-secret" },
            { "name": "suggestion", "value": "Send { url } with a valid x-vani-secret header; ensure VANI_RENDER_SECRET is set on the n8n instance" }
          ],
          "boolean": [
            { "name": "success", "value": false },
            { "name": "recoverable", "value": false }
          ]
        },
        "options": {}
      },
      "name": "Invalid Render Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [-1564, 360],
      "id": "b1b2c3d4-0004-4000-8000-000000000004"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "url", "value": "={{ $json.body.url }}" }
          ]
        },
        "options": {}
      },
      "name": "Prepare Render Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [-1564, 120],
      "id": "b1b2c3d4-0005-4000-8000-000000000005"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.BROWSERLESS_URL || 'http://localhost:3010') + '/content' + ($env.BROWSERLESS_TOKEN ? '?token=' + $env.BROWSERLESS_TOKEN : '') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, gotoOptions: { waitUntil: 'networkidle2', timeout: 45000 } }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "name": "Render Page (browserless)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1356, 120],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "id": "b1b2c3d4-0006-4000-8000-000000000006",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// browserless /content returns the rendered HTML as text.\n// With responseFormat=text the n8n HTTP node puts it in json.data.\n// Empty or errored -> structured error (no silent ok).\nconst item = $input.first().json;\nconst url = $('Prepare Render Data').first().json.url;\n\nif (item.error !== undefined) {\n  return {\n    success: false,\n    status: 'error',\n    errorCode: 'RENDER_FAILED',\n    message: 'Headless render failed',\n    details: String(item.error?.message || item.error).slice(0, 300),\n    url,\n    recoverable: true\n  };\n}\n\nconst html = typeof item.data === 'string' ? item.data : (item.body || item.html || '');\nif (typeof html !== 'string' || html.length < 100) {\n  return {\n    success: false,\n    status: 'error',\n    errorCode: 'RENDER_EMPTY',\n    message: 'Renderer returned no HTML',\n    details: `got ${typeof html === 'string' ? html.length + ' chars' : typeof html} — check BROWSERLESS_URL/TOKEN and that the container is running`,\n    url,\n    recoverable: true\n  };\n}\n\nreturn {\n  success: true,\n  url,\n  chars: html.length,\n  html\n};"
      },
      "name": "Format Render Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1148, 120],
      "id": "b1b2c3d4-0007-4000-8000-000000000007"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success === true }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Render OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-940, 120],
      "id": "b1b2c3d4-0008-4000-8000-000000000008"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "name": "Respond Render Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [-732, 0],
      "id": "b1b2c3d4-0009-4000-8000-000000000009"
    },
    {
      "parameters": {},
      "name": "Merge Render Errors",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [-940, 360],
      "id": "b1b2c3d4-0010-4000-8000-000000000010"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 400 }
      },
      "name": "Respond Render Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [-732, 360],
      "id": "b1b2c3d4-0011-4000-8000-000000000011"
    }
  ],
  "pinData": {},
