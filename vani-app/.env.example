# Origin of the VaNi API. Unset, the app runs entirely on the mock transport —
# no backend, no session — which is the right mode for pure UI work.
#
# Note the name: this app reads NEXT_PUBLIC_API_ORIGIN. VaNiGTM's frontend uses
# NEXT_PUBLIC_API_URL, which this app never reads, and setting the wrong one
# fails silently into mock mode rather than erroring.

# --- Local development (recommended) ---------------------------------------
# vani-backend running on your machine, pointed at the VPS Postgres.
# localhost:3000 <-> localhost:3002 is SAME-SITE (ports are irrelevant to
# SameSite), and NODE_ENV=development drops `secure` off the refresh cookie, so
# sessions genuinely persist. This is the only local mode where auth fully works.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3002

# --- Deployed (vani.vikuna.io on Vercel) -----------------------------------
# The browser calls the VPS directly — vani.vikuna.io and api.vikuna.io are
# same-site, so the SameSite=Strict refresh cookie still works and nginx keeps
# seeing the real browser origin. Do NOT proxy through Vercel: that replaces the
# browser origin and defeats the nginx allowlist.
#
# Requires on the VPS side: an SSL cert on api.vikuna.io, and the calling origin
# present in the `map $http_origin $cors_origin` allowlist in api.vikuna.io.conf
# (it defaults to "", so anything unlisted — including localhost — is refused).
# NEXT_PUBLIC_API_ORIGIN=https://api.vikuna.io
