# ============================================================
# VaNi AI — Main VPS deployment env vars (NAMES ONLY, no values here)
#
# Copy to .env in this directory before `docker compose ... up`. Never
# commit the real .env. This is a deliberate SUBSET of ../../backend/.env.example
# — assessment-skill needs no secrets beyond what the rest of this backend
# already requires (it reuses the existing auth/db layer end to end, no
# standalone JWT scheme, no new external service). Vars for skills nginx
# never proxies to on this host (GDRIVE_*, SEARXNG_URL, N8N_*) are omitted
# below on purpose — leave them unset; anything that tries to use them
# fails loudly (this codebase's "no silent fallbacks" rule), which is fine
# since nginx's allowlist (api.vikuna.io.conf) never routes public traffic
# to those skills anyway.
# ============================================================

# ── Instance ─────────────────────────────────────────────────
IMAGE_TAG=latest

# Docker network name shared with vikuna-postgres / vikuna-nginx / etc.
# See docker-compose.vani.yml's header comment for how to find this.
NETWORK_NAME=

# ── Database ─────────────────────────────────────────────────
# Same vani_gtm_db the rest of the GTM stack uses — this is NOT a separate
# database. Point at the existing vikuna-postgres container/network alias.
DB_PRIMARY=
DB_PRIMARY_SSL=false

# Runtime role vs owner role. DB_PRIMARY is what the API and worker run as —
# in production that is meant to be vanigtm_app (NOSUPERUSER NOBYPASSRLS, so
# RLS applies). DB_MIGRATE is the OWNER's connection (vikuna_admin), used ONLY
# by the migration runner, because migrations are DDL and the app role has
# none. Leave DB_MIGRATE unset while DB_PRIMARY is still the owner.
# DB_MIGRATE=postgresql://vikuna_admin:password@host:5432/vani_gtm_db

# ── Auth ─────────────────────────────────────────────────────
# MUST be the SAME value already in use by the rest of VaNiGTM's backend
# (whatever's deployed today) — changing it invalidates every existing
# vn_users session, not just VaNi AI's. Do not generate a new one for this
# deployment.
JWT_SECRET=
MAX_SESSIONS=

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Comma-behavior note: the existing Express cors() middleware
# (backend/src/server.ts) only accepts ONE static origin string — it does
# NOT support multiple/preview origins. CORS for this deployment is instead
# enforced at the nginx layer (api.vikuna.io.conf's $cors_origin map), which
# does support both the production and Vercel preview origins. Leave
# CORS_ORIGIN pointed at the production origin as a same-effect fallback for
# any direct (non-nginx) access during debugging:
CORS_ORIGIN=https://www.vikuna.io

# ── Feature flags (leave as-is unless intentionally changing) ─
VANI_MOCK=true

# ── LLM — ALL REQUIRED (no defaults in code, 2026-09-30) ──
# The API and worker refuse to start without every LLM_* line. Copy the full
# block from backend/.env.example ("Vikuna Agent Core — the LLM") and the
# fallback block after it. docs/llm-config.md lists each variable.
